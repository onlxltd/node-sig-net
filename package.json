{
    "name": "node-sig-net",
    "version": "0.0.1",
    "description": "A native TypeScript/Node implementation of the Sig-Net® protocol SDK.",
    "author": {
        "name": "ON LX Limited",
        "email": "team@onlx.ltd"
    },
    "bugs": {
        "url": "https://github.com/onlxltd/node-sig-net/issues"
    },
    "homepage": "https://github.com/onlxltd/node-sig-net",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "example:receiver": "yarn build && node examples/sine-receiver.mjs",
        "example:sender": "yarn build && node examples/sine-sender.mjs",
        "example:generator": "yarn build && node examples/generator.mjs",
        "example:snow-controller": "yarn build && node examples/snow-controller.mjs",
        "example:snow-beacon": "yarn build && node examples/snow-beacon.mjs",
        "example:snow-cert-generator": "yarn build && node examples/snow-cert-generator.mjs",
        "example:snow-device": "yarn build && node examples/snow-tls-device.mjs",
        "example:snow-persistent-device": "yarn build && node examples/snow-persistent-device.mjs",
        "example:snow-provisioner": "yarn build && node examples/snow-provisioner.mjs",
        "example:snow-recovery": "yarn build && node examples/snow-recovery.mjs",
        "format": "prettier --write .",
        "test": "node --test test/*.test.mjs",
        "update:upstream": "node scripts/update-upstream.mjs"
    },
    "keywords": [
        "sig-net",
        "coap",
        "dmx512",
        "typescript"
    ],
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^26.1.1",
        "prettier": "^3.9.4",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=18.17"
    },
    "packageManager": "yarn@4.18.0"
}
